    "CitationVerification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false,
      "description": "仅核验当前检索来源编号，不证明回答事实正确；空编号为 UNVERIFIED。"
    }
  }
