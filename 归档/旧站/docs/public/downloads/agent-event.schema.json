  "$defs": {
    "AgentBudgetUsage": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "agentCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "budgetUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "modelInvocationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "citationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "steps",
        "toolCalls",
        "agentCalls",
        "budgetUnits",
        "modelInvocationIds",
        "citationIds"
      ]
    },
    "AgentResult": {
      "type": "object",
      "properties": {
        "agentCallId": {
          "type": "string",
          "minLength": 1
        },
        "parentAgentCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "agentVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "const": "SUCCEEDED"
        },
        "text": {
          "type": "string"
        },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "TEXT"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "JSON"
                },
                "value": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/AgentBudgetUsage"
        }
      },
      "additionalProperties": false,
      "required": [
        "agentCallId",
        "parentAgentCallId",
        "depth",
        "agentId",
        "agentVersion",
        "status",
        "text",
        "output",
        "usage"
      ]
    },
    "KnowledgeSource": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "DOCUMENT",
            "URL",
            "INLINE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "locator": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "URL"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "uri"
            ]
          }
        }
      ]
    },
    "KnowledgeSelectedSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reason": {
          "enum": [
            "MODEL_REQUEST",
            "EAGER",
            "RULE_ALWAYS",
            "TRUSTED_CONTEXT",
            "QUERY_MATCH",
            "TAG_MATCH",
            "DESCRIPTION_TAG_MATCH"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "reason"
      ],
      "additionalProperties": false
